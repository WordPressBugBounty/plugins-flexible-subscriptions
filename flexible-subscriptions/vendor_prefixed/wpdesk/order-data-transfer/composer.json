{
    "name": "wpdesk\/order-data-transfer",
    "type": "library",
    "description": "Copy meta data and line items between orders.",
    "keywords": [
        "wpdesk",
        "order-data-transfer"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "WPDesk\\FlexibleSubscriptions\\Vendor\\WPDesk\\OrderDataTransfer\\": "src\/"
        }
    },
    "authors": [
        {
            "name": "WP Desk",
            "homepage": "https:\/\/wpdesk.net",
            "role": "Owner"
        }
    ],
    "require": {
        "php": "^7.4 | ^8"
    },
    "require-dev": {
        "phpunit\/phpunit": "^9.5",
        "wpdesk\/wp-code-sniffer": "^1",
        "wpdesk\/phpstan-rules": "^1"
    },
    "extra": {
        "text-domain": "order-data-transfer",
        "translations-folder": "lang"
    },
    "scripts": {
        "test": "phpunit",
        "check-style": "phpcs src tests",
        "fix-style": "phpcbf src tests"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect\/phpcodesniffer-composer-installer": true,
            "phpstan\/extension-installer": true
        }
    }
}