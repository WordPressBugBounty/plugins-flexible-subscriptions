{
    "name": "wpdesk\/wp-notice",
    "description": "Library for displaying Wordpress notices.",
    "license": "MIT",
    "keywords": [
        "wordpress",
        "notice",
        "admin"
    ],
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "WP Desk",
            "homepage": "https:\/\/wpdesk.net"
        },
        {
            "name": "Octolize",
            "homepage": "https:\/\/octolize.com"
        }
    ],
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "allow-plugins": {
            "kylekatarnls\/update-helper": true,
            "wpdesk\/wp-codeception": true,
            "dealerdirect\/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": ">=7.4 || ^8"
    },
    "suggest": {
        "wpdesk\/wp-builder": "Enables WP Builder integration."
    },
    "require-dev": {
        "10up\/wp_mock": "*",
        "mockery\/mockery": "*",
        "phpunit\/phpunit": "^8 || ^9",
        "wpdesk\/wp-builder": "^1.0|^2.0",
        "wpdesk\/wp-code-sniffer": "^1",
        "wpdesk\/wp-codeception": "^2"
    },
    "autoload": {
        "psr-4": {
            "WPDesk\\FlexibleSubscriptions\\Vendor\\WPDesk\\Notice\\": "src\/WPDesk\/Notice\/"
        },
        "files": [
            "src\/WPDesk\/notice-functions.php"
        ]
    },
    "autoload-dev": {},
    "scripts": {
        "phpcs": "phpcs --warning-severity=0",
        "lint": "phpcs --warning-severity=0",
        "phpunit-unit": "phpunit --configuration phpunit-unit.xml --coverage-text --colors=never",
        "phpunit-unit-fast": "phpunit --configuration phpunit-unit.xml --no-coverage",
        "phpunit-integration": "phpunit --configuration phpunit-integration.xml --coverage-text --colors=never",
        "phpunit-integration-fast": "phpunit --configuration phpunit-integration.xml --no-coverage"
    }
}